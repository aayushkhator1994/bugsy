<%- include('_head', {title: 'Your invoices'}) %>
<div class="page-head">
  <div>
    <h1>Your invoices</h1>
    <p class="sub"><%= rows.length %> invoice<%= rows.length === 1 ? '' : 's' %></p>
  </div>
  <a class="btn primary" href="/invoices/new">New invoice</a>
</div>
<div class="card">
  <table>
    <thead><tr><th>Invoice #</th><th>Client</th><th>Amount</th><th>Status</th></tr></thead>
    <tbody>
    <% rows.forEach(function(r) { %>
      <tr>
        <td class="num"><a href="/invoices/<%= r.id %>">#<%= r.id %></a></td>
        <td><%= r.client %></td>
        <td class="amt"><%= r.amount %></td>
        <td><span class="pill <%= r.status %>"><%= r.status %></span></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  <div class="total"><span class="v">Total outstanding: <%= outstanding %></span><span class="sub">unpaid invoices</span></div>
</div>
<%- include('_foot') %>
