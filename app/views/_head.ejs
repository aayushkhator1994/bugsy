<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · Satrang Sarees</title>
<style>
  :root {
    --bg: #f6f7f9; --card: #ffffff; --fg: #0f172a; --muted: #64748b; --line: #e2e8f0;
    --brand: #0f766e; --brand-ink: #ffffff; --brand-soft: #ccfbf1;
    --danger: #b91c1c; --danger-soft: #fee2e2; --ok: #166534; --ok-soft: #dcfce7; --warn: #92400e; --warn-soft: #fef3c7;
    --radius: 12px; --shadow: 0 1px 2px rgba(15,23,42,.06), 0 8px 24px rgba(15,23,42,.06);
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body {
    background: var(--bg); color: var(--fg);
    font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, Helvetica, Arial, sans-serif;
    min-height: 100vh; display: flex; flex-direction: column;
  }
  a { color: var(--brand); text-decoration: none; }
  a:hover { text-decoration: underline; }

  .topbar { background: var(--card); border-bottom: 1px solid var(--line); }
  .topbar .in { max-width: 880px; margin: 0 auto; padding: 14px 20px; display: flex; align-items: center; gap: 14px; }
  .logo { display: flex; align-items: center; gap: 10px; font-weight: 700; letter-spacing: -.01em; color: var(--fg); font-size: 17px; }
  .logo .mark { width: 28px; height: 28px; border-radius: 8px; background: var(--brand); color: var(--brand-ink); display: grid; place-items: center; font-size: 14px; font-weight: 800; }
  .topbar .who { margin-left: auto; color: var(--muted); font-size: 13px; display: flex; align-items: center; gap: 12px; }
  .topbar form { margin: 0; }

  main { flex: 1; width: 100%; max-width: 880px; margin: 0 auto; padding: 28px 20px 40px; }
  .page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin: 4px 0 18px; }
  h1 { font-size: 24px; letter-spacing: -.02em; margin: 0; }
  .sub { color: var(--muted); margin: 4px 0 0; font-size: 14px; }

  .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
  .card .pad { padding: 20px 22px; }

  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 13px 18px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  th { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 600; background: #fafbfc; }
  tbody tr:last-child td { border-bottom: 0; }
  tbody tr:hover td { background: #f8fafc; }
  td.num a { font-weight: 600; font-variant-numeric: tabular-nums; }
  td.amt { font-variant-numeric: tabular-nums; }
  .total { display: flex; justify-content: space-between; align-items: center; padding: 16px 18px; border-top: 1px solid var(--line); background: #fafbfc; border-radius: 0 0 var(--radius) var(--radius); font-weight: 600; }
  .total span.v { font-size: 18px; font-variant-numeric: tabular-nums; }

  .pill { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }
  .pill.Paid { background: var(--ok-soft); color: var(--ok); }
  .pill.Unpaid { background: var(--warn-soft); color: var(--warn); }

  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 9px; border: 1px solid var(--line); background: var(--card); color: var(--fg); font: inherit; font-weight: 600; cursor: pointer; }
  .btn:hover { background: #f8fafc; text-decoration: none; }
  .btn.primary { background: var(--brand); border-color: var(--brand); color: var(--brand-ink); }
  .btn.primary:hover { background: #0d6962; }
  .btn.ghost { border-color: transparent; background: transparent; color: var(--muted); }
  .btn.ghost:hover { color: var(--fg); background: #f1f5f9; }

  .facts p { margin: 0; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 16px; font-weight: 500; }
  .facts p:last-child { border-bottom: 0; }
  .facts p.amount { font-size: 26px; font-weight: 700; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }

  .banner { display: flex; align-items: center; gap: 10px; background: var(--ok-soft); color: var(--ok); border: 1px solid #bbf7d0; padding: 12px 16px; border-radius: 10px; margin: 0 0 16px; font-weight: 500; }
  .error { display: flex; align-items: center; gap: 10px; background: var(--danger-soft); color: var(--danger); border: 1px solid #fecaca; padding: 12px 16px; border-radius: 10px; margin: 0 0 16px; font-weight: 500; }

  form.stack { display: grid; gap: 14px; }
  label { display: grid; gap: 6px; font-size: 13px; font-weight: 600; color: var(--fg); }
  input[type=text], input[type=email], input[type=password], input[type=date] {
    font: inherit; padding: 10px 12px; border: 1px solid var(--line); border-radius: 9px; background: #fff; width: 100%;
  }
  input:focus { outline: 2px solid var(--brand-soft); border-color: var(--brand); }
  .actions { display: flex; gap: 10px; align-items: center; margin-top: 6px; }

  .auth { max-width: 400px; margin: 48px auto 0; }
  .auth .logo { justify-content: center; margin-bottom: 18px; font-size: 20px; }
  .auth h1 { text-align: center; margin-bottom: 4px; }
  .auth .sub { text-align: center; margin-bottom: 18px; }
  .hint { margin-top: 16px; font-size: 12px; color: var(--muted); text-align: center; }
  .hint code { background: #f1f5f9; padding: 1px 6px; border-radius: 5px; }

  .empty { text-align: center; padding: 48px 20px; }
  .empty h1 { margin-bottom: 8px; }

  footer { border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; }
  footer .in { max-width: 880px; margin: 0 auto; padding: 14px 20px; display: flex; justify-content: space-between; }

  :root { --brand:#9d174d; --brand-soft:#fce7f3; --ink:#1c1917; --fg:#1c1917; --bg:#faf7f2; --line:#e7e0d5; --muted:#78716c; }
  .promo { background: var(--ink); color: #fde8d0; text-align: center; font-size: 12.5px; padding: 7px 12px; letter-spacing: .02em; }
  .topbar { background:#fff; border-bottom:1px solid var(--line); position: sticky; top:0; z-index:5; }
  .topbar .in { max-width: 1040px; }
  .logo .mark { background: transparent; width: 34px; height: 34px; }
  .logo .mark svg { display:block; }
  .logo { font-size: 19px; }
  .search { flex:1; max-width: 420px; margin: 0 12px; position: relative; }
  .search input { width:100%; padding: 9px 14px 9px 38px; border-radius: 999px; border:1px solid var(--line); background:#faf7f2; font: inherit; font-size: 14px; }
  .search svg { position:absolute; left:13px; top:50%; transform:translateY(-50%); }
  .cart { position:relative; display:grid; place-items:center; width:38px; height:38px; border-radius:50%; color: var(--fg); }
  .cart:hover { background:#f5f0e8; }
  .cart .dot { position:absolute; top:2px; right:0; background:var(--brand); color:#fff; font-size:10px; font-weight:700; min-width:16px; height:16px; border-radius:8px; display:grid; place-items:center; }
  .subnav { background:#fff; border-bottom:1px solid var(--line); }
  .subnav .in { max-width:1040px; margin:0 auto; padding:0 20px; display:flex; gap:22px; font-size:13.5px; overflow-x:auto; }
  .subnav a { color: var(--muted); padding:10px 0; border-bottom:2px solid transparent; white-space:nowrap; }
  .subnav a.on { color: var(--fg); border-color: var(--brand); font-weight:600; }
  .subnav a:hover { color: var(--fg); text-decoration:none; }
  main { max-width: 1040px; }
  .hero { display:flex; align-items:center; justify-content:space-between; gap:20px; background: linear-gradient(120deg,#fdebd3,#fbd5b0); border-radius:16px; padding:22px 28px; margin-bottom:26px; overflow:hidden; }
  .hero b { display:block; font-size:19px; letter-spacing:-.01em; color:#500724; }
  .hero span { color:#831843; font-size:14px; }
  .hero svg { flex:none; }
  .hero .code { display:inline-block; margin-top:8px; border:1.5px dashed #9d174d; color:#831843; padding:2px 10px; border-radius:6px; font-weight:700; font-size:12px; letter-spacing:.08em; }
  .btn.primary:hover { background:#831843; }
  th { background:#faf7f2; }
  tbody tr:hover td { background:#fffaf3; }
  .total { background:#faf7f2; }
  .cell { display:flex; align-items:center; gap:12px; }
  .thumb { width:44px; height:44px; border-radius:10px; flex:none; display:block; }
  .perks { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-top:26px; }
  .perk { background:#fff; border:1px solid var(--line); border-radius:12px; padding:14px 16px; font-size:13px; color:var(--muted); }
  .perk b { display:block; color:var(--fg); font-size:14px; margin-bottom:2px; }
  .detail { display:grid; grid-template-columns: 220px 1fr; gap:26px; align-items:start; }
  .detail .big { width:100%; height:auto; border-radius:14px; }
  .auth { max-width: 420px; }
  footer { background:#fff; margin-top:30px; }
  footer .in { max-width:1040px; display:block; padding:26px 20px 18px; }
  footer .cols { display:grid; grid-template-columns:2fr 1fr 1fr 1fr; gap:24px; margin-bottom:20px; }
  footer h4 { margin:0 0 8px; color:var(--fg); font-size:13px; }
  footer .cols a { display:block; color:var(--muted); padding:2px 0; }
  footer .bottom { display:flex; justify-content:space-between; border-top:1px solid var(--line); padding-top:12px; }
  @media (max-width:700px){ .search{display:none} .perks,.detail{grid-template-columns:1fr} footer .cols{grid-template-columns:1fr 1fr} .hero svg{display:none} th,td{padding:10px 8px} .topbar .who span{display:none} }
</style>
</head>
<body>
<% if (typeof nav === 'undefined' || nav !== false) { %>
<div class="promo">Free shipping on orders over $50 &middot; Spring sale: take 15% off with code SATRANG15</div>
<div class="topbar"><div class="in">
  <a class="logo" href="/invoices"><span class="mark"><svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true"><rect width="34" height="34" rx="9" fill="#9d174d"/><path d="M23 11.5c-1.2-2-3.3-3-5.8-3-3 0-5 1.5-5 3.7 0 2.4 2.2 3.1 5.2 3.8 3 .7 5.3 1.5 5.3 4.1 0 2.4-2.2 4-5.4 4-2.8 0-5-1.1-6.3-3.2" fill="none" stroke="#fff" stroke-width="2.8" stroke-linecap="round"/></svg></span> Satrang Sarees</a>
  <div class="search"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#78716c" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg><input type="text" placeholder="Search for sarees" aria-label="Search products" autocomplete="off"></div>
  <div class="who">
    <% if (typeof userEmail !== 'undefined' && userEmail) { %><span><%= userEmail %></span><% } %>
    <a class="cart" href="/invoices" aria-label="Cart"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2l2.4 11h10.2L20 7H6"/><circle cx="9" cy="19.5" r="1.4"/><circle cx="17" cy="19.5" r="1.4"/></svg><span class="dot">2</span></a>
    <form method="post" action="/logout"><button class="btn ghost" type="submit">Sign out</button></form>
  </div>
</div></div>
<div class="subnav"><div class="in"><a href="/invoices" class="on">My account</a><a href="/invoices">Orders &amp; billing</a><a href="/invoices">Wishlist</a><a href="/invoices">Addresses</a><a href="/invoices">Help centre</a></div></div>
<% } %>
