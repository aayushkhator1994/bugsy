<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · Ledger</title>
<style>
  :root {
    --bg: #f6f7f9; --card: #ffffff; --fg: #0f172a; --muted: #64748b; --line: #e2e8f0;
    --brand: #0f766e; --brand-ink: #ffffff; --brand-soft: #ccfbf1;
    --danger: #b91c1c; --danger-soft: #fee2e2; --ok: #166534; --ok-soft: #dcfce7; --warn: #92400e; --warn-soft: #fef3c7;
    --radius: 12px; --shadow: 0 1px 2px rgba(15,23,42,.06), 0 8px 24px rgba(15,23,42,.06);
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body {
    background: var(--bg); color: var(--fg);
    font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, Helvetica, Arial, sans-serif;
    min-height: 100vh; display: flex; flex-direction: column;
  }
  a { color: var(--brand); text-decoration: none; }
  a:hover { text-decoration: underline; }

  .topbar { background: var(--card); border-bottom: 1px solid var(--line); }
  .topbar .in { max-width: 880px; margin: 0 auto; padding: 14px 20px; display: flex; align-items: center; gap: 14px; }
  .logo { display: flex; align-items: center; gap: 10px; font-weight: 700; letter-spacing: -.01em; color: var(--fg); font-size: 17px; }
  .logo .mark { width: 28px; height: 28px; border-radius: 8px; background: var(--brand); color: var(--brand-ink); display: grid; place-items: center; font-size: 14px; font-weight: 800; }
  .topbar .who { margin-left: auto; color: var(--muted); font-size: 13px; display: flex; align-items: center; gap: 12px; }
  .topbar form { margin: 0; }

  main { flex: 1; width: 100%; max-width: 880px; margin: 0 auto; padding: 28px 20px 40px; }
  .page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin: 4px 0 18px; }
  h1 { font-size: 24px; letter-spacing: -.02em; margin: 0; }
  .sub { color: var(--muted); margin: 4px 0 0; font-size: 14px; }

  .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
  .card .pad { padding: 20px 22px; }

  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 13px 18px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  th { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 600; background: #fafbfc; }
  tbody tr:last-child td { border-bottom: 0; }
  tbody tr:hover td { background: #f8fafc; }
  td.num a { font-weight: 600; font-variant-numeric: tabular-nums; }
  td.amt { font-variant-numeric: tabular-nums; }
  .total { display: flex; justify-content: space-between; align-items: center; padding: 16px 18px; border-top: 1px solid var(--line); background: #fafbfc; border-radius: 0 0 var(--radius) var(--radius); font-weight: 600; }
  .total span.v { font-size: 18px; font-variant-numeric: tabular-nums; }

  .pill { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }
  .pill.Paid { background: var(--ok-soft); color: var(--ok); }
  .pill.Unpaid { background: var(--warn-soft); color: var(--warn); }

  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 9px; border: 1px solid var(--line); background: var(--card); color: var(--fg); font: inherit; font-weight: 600; cursor: pointer; }
  .btn:hover { background: #f8fafc; text-decoration: none; }
  .btn.primary { background: var(--brand); border-color: var(--brand); color: var(--brand-ink); }
  .btn.primary:hover { background: #0d6962; }
  .btn.ghost { border-color: transparent; background: transparent; color: var(--muted); }
  .btn.ghost:hover { color: var(--fg); background: #f1f5f9; }

  .facts p { margin: 0; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 16px; font-weight: 500; }
  .facts p:last-child { border-bottom: 0; }
  .facts p.amount { font-size: 26px; font-weight: 700; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }

  .banner { display: flex; align-items: center; gap: 10px; background: var(--ok-soft); color: var(--ok); border: 1px solid #bbf7d0; padding: 12px 16px; border-radius: 10px; margin: 0 0 16px; font-weight: 500; }
  .error { display: flex; align-items: center; gap: 10px; background: var(--danger-soft); color: var(--danger); border: 1px solid #fecaca; padding: 12px 16px; border-radius: 10px; margin: 0 0 16px; font-weight: 500; }

  form.stack { display: grid; gap: 14px; }
  label { display: grid; gap: 6px; font-size: 13px; font-weight: 600; color: var(--fg); }
  input[type=text], input[type=email], input[type=password], input[type=date] {
    font: inherit; padding: 10px 12px; border: 1px solid var(--line); border-radius: 9px; background: #fff; width: 100%;
  }
  input:focus { outline: 2px solid var(--brand-soft); border-color: var(--brand); }
  .actions { display: flex; gap: 10px; align-items: center; margin-top: 6px; }

  .auth { max-width: 400px; margin: 48px auto 0; }
  .auth .logo { justify-content: center; margin-bottom: 18px; font-size: 20px; }
  .auth h1 { text-align: center; margin-bottom: 4px; }
  .auth .sub { text-align: center; margin-bottom: 18px; }
  .hint { margin-top: 16px; font-size: 12px; color: var(--muted); text-align: center; }
  .hint code { background: #f1f5f9; padding: 1px 6px; border-radius: 5px; }

  .empty { text-align: center; padding: 48px 20px; }
  .empty h1 { margin-bottom: 8px; }

  footer { border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; }
  footer .in { max-width: 880px; margin: 0 auto; padding: 14px 20px; display: flex; justify-content: space-between; }
</style>
</head>
<body>
<% if (typeof nav === 'undefined' || nav !== false) { %>
<div class="topbar"><div class="in">
  <a class="logo" href="/invoices"><span class="mark">L</span> Ledger</a>
  <div class="who">
    <% if (typeof userEmail !== 'undefined' && userEmail) { %><span><%= userEmail %></span><% } %>
    <form method="post" action="/logout"><button class="btn ghost" type="submit">Sign out</button></form>
  </div>
</div></div>
<% } %>
<main>
